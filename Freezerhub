-- Player Dropdown Logic
local selectedPlayer = nil

local function updatePlayerList()
    for _, child in pairs(DropListHolder:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local count = 0
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count = count + 1
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 22)
            Btn.BackgroundColor3 = Color3.fromRGB(38, 25, 56)
            Btn.BorderSizePixel = 0
            Btn.Text = " " .. plr.Name
            Btn.TextColor3 = Color3.fromRGB(220, 200, 240)
            Btn.TextSize = 10
            Btn.Font = Enum.Font.Gotham
            Btn.TextXAlignment = Enum.TextXAlignment.Left
            Btn.ZIndex = 11
            Btn.Parent = DropListHolder
            
            Btn.MouseButton1Click:Connect(function()
                selectedPlayer = plr
                SelectedText.Text = "Target: " .. plr.Name
                DropListHolder.Visible = false
                StatusLog.Text = "Target: " .. plr.Name
            end)
        end
    end
    DropListHolder.CanvasSize = UDim2.new(0, 0, 0, count * 22)
end

SelectedText.MouseButton1Click:Connect(function()
    DropListHolder.Visible = not DropListHolder.Visible
    if DropListHolder.Visible then
        updatePlayerList()
    end
end)

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)

